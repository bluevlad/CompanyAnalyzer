.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/
.venv/
.env.local

# PyInstaller
*.manifest
*.spec

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/

# -------------------------------------------
