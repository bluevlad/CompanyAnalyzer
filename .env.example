# CompanyAnalyzer Environment Variables

# Database
DB_PASSWORD=your-secure-password-here
DATABASE_URL=postgresql+asyncpg://postgres:${DB_PASSWORD}@localhost:5432/companyanalyzer
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:${DB_PASSWORD}@localhost:5432/companyanalyzer

# LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
ANALYSIS_MODEL=gemma3:12b
PREPROCESSING_MODEL=gemma3:4b

# 크롤링 설정
MAX_CRAWL_PAGES=10
CRAWL_DELAY_SECONDS=2

# URLs
FRONTEND_URL=http://localhost:4080
BACKEND_URL=http://localhost:9080

# 인증 (Google GSI — CLIENT_SECRET 불필요)
GOOGLE_CLIENT_ID=
SUPER_ADMIN_EMAILS=
JWT_SECRET_KEY=change-me

# Email / SMTP (선택 - 미설정 시 이메일 발송 비활성화)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CompanyAnalyzer
SMTP_USE_TLS=true
