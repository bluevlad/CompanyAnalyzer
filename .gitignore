# -------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output
frontend/dist/
frontend/build/
.next/
out/

# -------------------------------------------
# Claude Code
# -------------------------------------------
.claude/

# -------------------------------------------
# IDE / Editor
# -------------------------------------------
.vscode/
*.code-workspace
.idea/
*.iml
*.ipr
*.iws
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# -------------------------------------------
